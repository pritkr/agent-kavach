{
  "tools": [
    {
      "name": "shell-sandboxed",
      "description": "Run a command inside the workspace with a wall-clock timeout. No network, output truncated at 64 KiB.",
      "input_schema": {
        "type": "object",
        "required": ["command"],
        "properties": {
          "command": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1,
            "maxItems": 64,
            "description": "argv vector, e.g. [\"ls\", \"-la\"]"
          },
          "timeout_sec": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "default": 30,
            "description": "Wall-clock timeout, max 30s"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "file-read",
      "description": "Read a text file scoped to the workspace root. Symlink escapes and absolute paths outside the workspace are rejected.",
      "input_schema": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Workspace-relative path, e.g. \"notes/todo.md\""
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576,
            "default": 65536,
            "description": "Max bytes to return, cap 1 MiB"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "web-fetch",
      "description": "Fetch an http(s) URL whose host is on the allowlist. Returns status + truncated body.",
      "input_schema": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": {
            "type": "string",
            "minLength": 8,
            "maxLength": 2048,
            "description": "Fully-qualified http(s) URL on an allowlisted host"
          },
          "timeout_sec": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "default": 10,
            "description": "Fetch timeout, max 30s"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "scheme-lookup",
      "description": "Look up a named execution scheme (timeout/retry/cost budget preset) from the local registry.",
      "input_schema": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Scheme name, e.g. \"fast\", \"balanced\", \"thorough\""
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "eval-run",
      "description": "Execute a workspace-scoped Python script file with a wall-clock timeout and capture exit code + output.",
      "input_schema": {
        "type": "object",
        "required": ["script"],
        "properties": {
          "script": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Workspace-relative path to a .py file, e.g. \"checks/smoke.py\""
          },
          "timeout_sec": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "default": 30,
            "description": "Wall-clock timeout, max 30s"
          }
        },
        "additionalProperties": false
      }
    }
  ]
}
